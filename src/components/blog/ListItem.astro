---
import { Icon } from 'astro-icon/components';
import PostTags from '~/components/blog/Tags.astro';

import { APP_BLOG } from 'astrowind:config';
import type { Post } from '~/types';

import { getPermalink } from '~/utils/permalinks';
import { findImage } from '~/utils/images';
import { getFormattedDate } from '~/utils/utils';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const image = await findImage(post.image);

const link = post.externalUrl || (APP_BLOG?.post?.isEnabled ? getPermalink(post.permalink, 'post') : '');
---

<article
  class="mx-auto flex max-w-md flex-col items-start gap-5 sm:max-w-none sm:flex-row sm:gap-6 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
>
  {
    image &&
      (link ? (
        <a class="block w-full shrink-0 sm:w-64 md:w-72" href={link} aria-label={`Read: ${post.title}`}>
          <img
            src={typeof image === 'string' ? image : image.src}
            class="block h-auto w-full"
            alt={post.title}
            width={typeof image === 'string' ? undefined : image.width}
            height={typeof image === 'string' ? undefined : image.height}
            loading="lazy"
            decoding="async"
          />
        </a>
      ) : (
        <div class="w-full shrink-0 sm:w-64 md:w-72">
          <img
            src={typeof image === 'string' ? image : image.src}
            class="block h-auto w-full"
            alt={post.title}
            width={typeof image === 'string' ? undefined : image.width}
            height={typeof image === 'string' ? undefined : image.height}
            loading="lazy"
            decoding="async"
          />
        </div>
      ))
  }
  <div class="min-w-0 flex-1">
    <header>
      <div class="mb-1">
        <span class="text-xs">
          <Icon name="tabler:clock" class="w-3.5 h-3.5 inline-block -mt-0.5 dark:text-gray-400" />
          <time datetime={String(post.publishDate)} class="inline-block">{getFormattedDate(post.publishDate)}</time>
          {
            post.author && (
              <>
                {' '}
                · <Icon name="tabler:user" class="w-3.5 h-3.5 inline-block -mt-0.5 dark:text-gray-400" />
                <span>{post.author.replaceAll('-', ' ')}</span>
              </>
            )
          }
          {
            post.category && (
              <>
                {' '}
                ·{' '}
                <a class="hover:underline" href={getPermalink(post.category.slug, 'category')}>
                  {post.category.title}
                </a>
              </>
            )
          }
        </span>
      </div>
      <h2 class="text-base sm:text-lg font-bold leading-tight mb-2 font-heading dark:text-slate-300">
        {
          link ? (
            <a
              class="inline-block hover:text-primary dark:hover:text-blue-700 transition ease-in duration-200"
              href={link}
            >
              {post.title}
            </a>
          ) : (
            post.title
          )
        }
      </h2>
    </header>

    {post.excerpt && <p class="flex-grow text-muted dark:text-slate-400 text-sm">{post.excerpt}</p>}
    {
      post.externalUrl && (
        <a href={post.externalUrl} class="mt-3 inline-block text-sm hover:underline">
          Read on Medium ↗
        </a>
      )
    }
    {
      post.tags && Array.isArray(post.tags) ? (
        <footer class="mt-5">
          <PostTags tags={post.tags} />
        </footer>
      ) : (
        <Fragment />
      )
    }
  </div>
</article>
