---
import type { CollectionEntry } from 'astro:content';

// 1. Pull in the exact schema for your "publications" collection:
type PubEntry = CollectionEntry<'publications'>;

// 2. Define Props so that `items` is an array of those entries:
export interface Props {
  items: PubEntry[];
}

// 3. Cast Astro.props so TS knows each `item.data.xxx` is the right type.
const { items = [] } = Astro.props as Props;
---

<div class="space-y-8">
  {
    items.map(({ data }) => (
      <a
        href={data.externalUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="group flex flex-col items-start gap-5 rounded-lg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-600 sm:flex-row sm:items-center sm:gap-7"
      >
        <div class="h-36 w-36 shrink-0 overflow-hidden rounded-md border border-slate-200 bg-white sm:h-40 sm:w-40">
          <img
            src={data.thumbnail}
            alt={data.title}
            class="w-full h-full object-contain"
            width={160}
            height={160}
            loading="lazy"
          />
        </div>

        <div class="max-w-2xl">
          <h3 class="text-lg font-semibold leading-relaxed text-blue-700 group-hover:underline">{data.title}</h3>
          <p class="mt-2 text-base text-muted dark:text-slate-400">{data.description}</p>
          <span class="mt-3 inline-block text-sm font-medium text-blue-700">Project page ↗</span>
        </div>
      </a>
    ))
  }
</div>
