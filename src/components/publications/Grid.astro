---
import type { CollectionEntry } from 'astro:content';

// 1. Pull in the exact schema for your "publications" collection:
type PubEntry = CollectionEntry<'publications'>;

// 2. Define Props so that `items` is an array of those entries:
export interface Props {
  items: PubEntry[];
}

// 3. Cast Astro.props so TS knows each `item.data.xxx` is the right type.
const { items = [] } = Astro.props as Props;
---

<div class="space-y-8">
  {
    items.map(({ data }) => (
      <article class="flex flex-col items-start gap-5 tracking-normal sm:flex-row sm:gap-6">
        <a
          href={data.externalUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="block w-36 shrink-0 sm:w-40"
          aria-label={`Project page: ${data.title}`}
        >
          <img
            src={data.thumbnail}
            alt={data.title}
            class="block h-auto w-full"
            width={160}
            height={160}
            loading="lazy"
          />
        </a>

        <div class="publication-text max-w-2xl">
          <h3 class="font-bold leading-snug">
            <a href={data.externalUrl} target="_blank" rel="noopener noreferrer" class="hover:underline">
              {data.title}
            </a>
          </h3>
          <p class="mt-2 leading-snug text-[#666666]">
            {data.authors.map((author, index) => (
              <>
                {index > 0 && ', '}
                {author.highlight ? <strong class="font-bold text-[#333333]">{author.name}</strong> : author.name}
              </>
            ))}
          </p>
          <p class="mt-2 leading-snug text-[#24292e]">
            <em>
              {data.conference} ({data.conferenceShort})
            </em>
            , {data.year}
          </p>
          <nav aria-label={`Resources for ${data.title}`} class="mt-1 flex flex-wrap gap-x-1.5 leading-snug">
            <a href={data.externalUrl} target="_blank" rel="noopener noreferrer" class="hover:underline">
              project page
            </a>
            {data.arxivUrl && (
              <>
                <span aria-hidden="true">/</span>
                <a href={data.arxivUrl} target="_blank" rel="noopener noreferrer" class="hover:underline">
                  arXiv
                </a>
              </>
            )}
            {data.codeUrl && (
              <>
                <span aria-hidden="true">/</span>
                <a href={data.codeUrl} target="_blank" rel="noopener noreferrer" class="hover:underline">
                  code
                </a>
              </>
            )}
          </nav>
        </div>
      </article>
    ))
  }
</div>

<style>
  .publication-text {
    font-size: var(--aw-publication-font-size);
  }
</style>
