---
import Layout from '~/layouts/PageLayout.astro';

import { Icon } from 'astro-icon/components';
import PublicationsLatest from '~/components/widgets/PublicationsLatest.astro';
import Timeline from '~/components/widgets/Timeline.astro';

const metadata = {
  title: 'Shubhranil B',
  description:
    'I build learning systems that generalize beyond their training data—across domains, categories, languages, and real-world constraints.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <section aria-labelledby="profile-name" class="bg-[#f3f8fc]">
    <div class="mx-auto flex max-w-5xl flex-col items-center gap-7 px-6 py-10 sm:flex-row sm:gap-10 sm:py-14">
      <div
        role="img"
        aria-label="Profile photo placeholder for Shubhranil B"
        class="flex h-36 w-36 shrink-0 flex-col items-center justify-center rounded-full border-[5px] border-white bg-[#e2ebf1] text-[#5b7183] sm:h-44 sm:w-44"
      >
        <Icon name="tabler:user" class="h-16 w-16" aria-hidden="true" />
        <span class="mt-1 text-xs">Photo coming soon</span>
      </div>
      <div class="max-w-2xl text-center sm:text-left">
        <h1 id="profile-name" class="text-3xl font-bold tracking-tight text-[#526b7d] sm:text-4xl">Shubhranil B</h1>
        <p class="mt-4 text-lg leading-relaxed text-slate-700">{metadata.description}</p>
        <nav aria-label="Profile links" class="mt-5 flex flex-wrap justify-center gap-x-6 gap-y-3 sm:justify-start">
          <a
            class="profile-link"
            href="https://www.linkedin.com/in/shubhranil-b-iitb/"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="tabler:brand-linkedin" class="h-5 w-5" aria-hidden="true" /> LinkedIn
          </a>
          <a class="profile-link" href="https://github.com/Shubh-Nil" target="_blank" rel="noopener noreferrer">
            <Icon name="tabler:brand-github" class="h-5 w-5" aria-hidden="true" /> GitHub
          </a>
          <a class="profile-link" href="/documents/Resume_Shubhranil.pdf" download="Resume_Shubhranil.pdf">
            <Icon name="tabler:download" class="h-5 w-5" aria-hidden="true" /> Résumé
          </a>
        </nav>
      </div>
    </div>
  </section>

  <Timeline />

  <!-- HighlightedPosts Widget ******* -->

  <PublicationsLatest
    id="publications"
    title="Recent publications"
    classes={{ container: 'max-w-5xl pt-0 md:pt-0 lg:pt-0' }}
  />
</Layout>

<style>
  .profile-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #2563a6;
    font-size: 0.95rem;
    font-weight: 500;
  }
  .profile-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .profile-link:focus-visible {
    outline: 2px solid #2563a6;
    outline-offset: 5px;
    border-radius: 2px;
  }
</style>
