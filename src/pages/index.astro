---
import Layout from '~/layouts/PageLayout.astro';

import { Icon } from 'astro-icon/components';
import PublicationsLatest from '~/components/widgets/PublicationsLatest.astro';
import Timeline from '~/components/widgets/Timeline.astro';

const metadata = {
  title: 'Shubhranil B',
  description:
    'I build learning systems that generalize beyond their training data—across domains, categories, languages, and real-world constraints.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <section aria-labelledby="profile-name" class="bg-[#f3f8fc]">
    <div class="mx-auto flex max-w-5xl flex-col items-center gap-7 px-6 py-10 sm:flex-row sm:gap-10 sm:py-14">
      <div
        role="img"
        aria-label="Profile photo placeholder for Shubhranil B"
        class="flex h-36 w-36 shrink-0 flex-col items-center justify-center rounded-full border-[5px] border-white bg-[#e2ebf1] text-[#5b7183] sm:h-44 sm:w-44"
      >
        <Icon name="tabler:user" class="h-16 w-16" aria-hidden="true" />
        <span class="mt-1 text-xs">Photo coming soon</span>
      </div>
      <div class="max-w-2xl text-center sm:text-left">
        <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 sm:justify-start">
          <h1 id="profile-name" class="text-[2rem] font-extrabold leading-tight tracking-tight text-[#536d80]">
            Shubhranil B
          </h1>
          <nav aria-label="Profile links" class="flex items-center gap-3">
            <a
              class="profile-link"
              href="https://www.linkedin.com/in/shubhranil-b-iitb/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn"
              title="LinkedIn"
            >
              <Icon name="tabler:brand-linkedin" class="h-[18px] w-[18px]" aria-hidden="true" />
            </a>
            <a
              class="profile-link"
              href="https://github.com/Shubh-Nil"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="GitHub"
              title="GitHub"
            >
              <Icon name="tabler:brand-github" class="h-[18px] w-[18px]" aria-hidden="true" />
            </a>
            <a
              class="profile-link"
              href="/documents/Resume_Shubhranil.pdf"
              download="Resume_Shubhranil.pdf"
              aria-label="Download résumé"
              title="Download résumé"
            >
              <Icon name="tabler:file-cv" class="h-[18px] w-[18px]" aria-hidden="true" />
            </a>
          </nav>
        </div>
        <p class="profile-bio mt-3 leading-[1.5] tracking-normal text-[#24292e]">{metadata.description}</p>
      </div>
    </div>
  </section>

  <Timeline />

  <!-- HighlightedPosts Widget ******* -->

  <PublicationsLatest
    id="publications"
    title="Recent publications"
    classes={{ container: 'max-w-5xl pt-0 md:pt-0 lg:pt-0' }}
  />
</Layout>

<style>
  .profile-bio {
    font-size: var(--aw-bio-font-size);
  }

  .profile-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    min-height: 24px;
    color: var(--aw-color-link);
  }
  .profile-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .profile-link:focus-visible {
    outline: 2px solid var(--aw-color-link);
    outline-offset: 5px;
    border-radius: 2px;
  }
</style>
